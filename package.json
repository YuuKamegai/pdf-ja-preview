{
  "name": "pdf-ja-preview",
  "description": "英語の PDF を、原文と日本語訳を左右に並べて読むためのローカル Web アプリ",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YuuKamegai/pdf-ja-preview.git"
  },
  "scripts": {
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p test/web-e2e/tsconfig.json",
    "test:web": "node --import tsx --test \"test/web/**/*.test.ts\"",
    "build:web": "node web/esbuild.mjs",
    "watch:web": "node web/esbuild.mjs --watch",
    "start:web": "node dist-web/server.cjs",
    "pretest:e2e:web": "npm run build:web",
    "test:e2e:web": "playwright test --config playwright.pdf.config.ts",
    "test": "npm run typecheck:web && npm run test:web"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.4",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
