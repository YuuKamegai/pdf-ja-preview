   "self_ref": "#/texts/1",
   "text": "Left first. The instrument was calibrated before each of the 12 runs, and the drift was kept below 0.5 percent over 30 min. Every sample was measured three times and the median value was retained."
  },
  {
   "children": [],
   "content_layer": "body",
   "label": "text",
   "orig": "Left second. Cooling was applied at a fixed rate of 2 C per minute until the target of 25 C was reached. The holding time was 10 min for all conditions.",
   "parent": {
    "$ref": "#/body"
   },
   "prov": [
    {
     "bbox": {
      "b": 504.723,
      "coord_origin": "BOTTOMLEFT",
